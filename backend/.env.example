# Environment variables for local development
# Copy this file to .env and customize values for your machine.

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/mani_saas
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=changeme
JWT_SECRET=change-this-secret-to-a-strong-value
JWT_EXPIRATION_MS=3600000
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AUTH_BOOTSTRAP_ENABLED=true
AUTH_BOOTSTRAP_USERNAME=admin
AUTH_BOOTSTRAP_PASSWORD=admin 
AUTH_BOOTSTRAP_TENANT_ID=1
AUTH_BOOTSTRAP_ROLE=SUPERADMIN
AUTH_BOOTSTRAP_ALLOW_DEFAULT_CREDENTIALS=false
JWT_ALLOW_INSECURE_DEV_KEY=false
